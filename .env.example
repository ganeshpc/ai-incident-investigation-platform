# Copy this file to .env and fill in local values.
# Never commit .env. Do not put real secrets in this template.

# Selected LLM provider for real investigations. The Python AI service reads this.
# Tests use a fake provider and do not call this endpoint.
LLM_PROVIDER=openai

# OpenAI API key for ChatGPT models.
# https://developers.openai.com/api/docs/quickstart
# Server-side only. The browser must never receive this value.
OPENAI_API_KEY=

# Lowest-cost current text model on the OpenAI pricing page as of 2026-10-26.
# Standard rate: $0.10 / 1M input tokens, $0.50 / 1M output tokens.
# https://developers.openai.com/api/docs/models/gpt-6-luna
OPENAI_MODEL=gpt-6-luna

# Luna defaults to medium reasoning. none avoids those billed output tokens.
OPENAI_REASONING_EFFORT=none

# Optional. Set only when a key must target one organization or project.
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Alternate provider. Unused while LLM_PROVIDER=openai.
# xAI API key for model calls (https://docs.x.ai). Server-side only.
XAI_API_KEY=

# Optional. The OpenAI SDK uses https://api.openai.com/v1 when this is unset.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local process ports.
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# Local PostgreSQL started with docker compose. Not a production password.
POSTGRES_DB=investigator
POSTGRES_USER=investigator
POSTGRES_PASSWORD=investigator
